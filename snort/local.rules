# -----------------------------
# Custom Snort Local Rules
# SID range reserved for local rules: 1000001+
# -----------------------------

# 1) SQL Injection attempts in HTTP URI/body
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-ATTACK SQL Injection keyword in URI";
    flow:to_server,established;
    http_uri;
    pcre:"/(\%27)|(')|(\-\-)|(\%23)|(#)|((\%3D)|(=)).*((\%27)|(')|(\%3B)|(;))/Ui";
    classtype:web-application-attack;
    sid:1000001;
    rev:1;
)

alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-ATTACK SQL Injection UNION SELECT attempt";
    flow:to_server,established;
    http_uri;
    content:"union"; nocase;
    content:"select"; nocase; distance:0; within:30;
    classtype:web-application-attack;
    sid:1000002;
    rev:1;
)

# 2) Port scanning (SYN scan heuristics)
alert tcp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"RECON Potential TCP SYN port scan";
    flags:S;
    threshold:type both, track by_src, count 20, seconds 10;
    classtype:attempted-recon;
    sid:1000003;
    rev:1;
)

# 3) DDoS/SYN flood indicator
alert tcp $EXTERNAL_NET any -> $HOME_NET any (
    msg:"DOS Potential SYN flood / DDoS burst";
    flags:S;
    threshold:type both, track by_dst, count 200, seconds 5;
    classtype:attempted-dos;
    sid:1000004;
    rev:1;
)

# 4) Brute-force login attack detection (common login URIs)
alert tcp $EXTERNAL_NET any -> $HOME_NET $HTTP_PORTS (
    msg:"WEB-ATTACK Possible HTTP brute-force login attempts";
    flow:to_server,established;
    http_uri;
    pcre:"/\/(login|signin|auth|wp-login\.php)/Ui";
    threshold:type both, track by_src, count 15, seconds 60;
    classtype:attempted-admin;
    sid:1000005;
    rev:1;
)
